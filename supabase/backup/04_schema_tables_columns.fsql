-- id UUID PK, attributes JSONB, created_at TIMESTAMPTZ, images TEXT[], is_active BOOLEAN, mrp NUMERIC, name TEXT, price NUMERIC, product_id UUID FK(products), serial_number TEXT, sort_order INT, stock_quantity INT, updated_at TIMESTAMPTZ, video_url TEXT

