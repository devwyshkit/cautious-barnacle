-- id UUID PK, created_at TIMESTAMPTZ, description TEXT, images TEXT[], order_id UUID NOT NULL FK(orders), reason TEXT NOT NULL, refund_amount NUMERIC, return_delivery_fee NUMERIC, status TEXT, updated_at TIMESTAMPTZ, user_id UUID NOT NULL FK(users)

