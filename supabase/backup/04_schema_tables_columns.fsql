-- id UUID PK, available_for_order BOOLEAN, base_price NUMERIC NOT NULL, brand TEXT, care_instructions TEXT, category_id UUID FK(categories), country_of_origin TEXT, created_at TIMESTAMPTZ, description TEXT, dimensions JSONB, fragile BOOLEAN, fts TSVECTOR, gst_percentage NUMERIC, has_personalization BOOLEAN, hsn_code TEXT, images TEXT[], is_active BOOLEAN, is_perishable BOOLEAN, low_stock_threshold INT, manufacturer_info TEXT, material TEXT, max_change_requests INT, max_order_quantity INT, min_order_quantity INT, mrp NUMERIC, name TEXT NOT NULL, packaging_type TEXT, personalization_fee NUMERIC, personalization_options JSONB, personalization_schema JSONB, preview_time_minutes INT, production_time_minutes INT, rating NUMERIC, shelf_life_hours INT, sku TEXT, slug TEXT NOT NULL, sort_order INT, stock_quantity INT, stock_status TEXT, tags TEXT[], total_ratings INT, updated_at TIMESTAMPTZ, vendor_id UUID NOT NULL FK(vendors), video_url TEXT, weight_kg NUMERIC

