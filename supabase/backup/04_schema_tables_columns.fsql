-- ENUMS
CREATE TYPE public.order_status AS ENUM (
  'PLACED', 'CONFIRMED', 'IN_PRODUCTION', 'PACKED',
  'RIDER_ASSIGNED', 'ARRIVED_PICKUP', 'OUT_FOR_DELIVERY', 'ARRIVED_DROP',
  'DELIVERED', 'CANCELLED', 'REFUNDED'
);

-- ==================== TABLES ====================

-- addon_groups
-- id UUID PK, created_at TIMESTAMPTZ, description TEXT, is_required BOOLEAN, max_select INT, min_select INT, name TEXT NOT NULL, vendor_id UUID FK(vendors)

-- cart_products  
-- id UUID PK, cart_id UUID FK(carts), created_at TIMESTAMPTZ, expires_at TIMESTAMPTZ, personalization JSONB, product_id UUID NOT NULL FK(products), quantity INT, selected_addons JSONB, selected_variant_id UUID FK(product_variants), session_id TEXT, updated_at TIMESTAMPTZ, user_id UUID FK(users)

-- carts
-- id UUID PK, created_at TIMESTAMPTZ, session_id TEXT, updated_at TIMESTAMPTZ, user_id UUID

-- categories
-- id UUID PK, created_at TIMESTAMPTZ, display_order INT, image_url TEXT, is_active BOOLEAN, name TEXT NOT NULL, parent_id UUID FK(categories), slug TEXT NOT NULL, updated_at TIMESTAMPTZ

-- checkout_sessions
-- id UUID PK, applied_coupon TEXT FK(coupons.code), created_at TIMESTAMPTZ, expires_at TIMESTAMPTZ, gstin TEXT, guest_lat NUMERIC, guest_lng NUMERIC, guest_location_name TEXT, selected_address_id UUID FK(user_addresses), session_id TEXT, snapshot_products JSONB, updated_at TIMESTAMPTZ, use_wallet BOOLEAN, user_id UUID FK(users)

-- coupons
-- id UUID PK, code TEXT NOT NULL UNIQUE, created_at TIMESTAMPTZ, created_by_vendor_id UUID FK(vendors), description TEXT, discount_type TEXT NOT NULL, discount_value NUMERIC NOT NULL, end_date TIMESTAMPTZ, is_active BOOLEAN, is_platform_coupon BOOLEAN, max_discount_amount NUMERIC, min_order_value NUMERIC, start_date TIMESTAMPTZ, usage_limit INT, used_count INT

-- notifications
-- id UUID PK, body TEXT NOT NULL, created_at TIMESTAMPTZ, is_read BOOLEAN, metadata JSONB, title TEXT NOT NULL, type TEXT NOT NULL, user_id UUID NOT NULL FK(users)

-- order_products
-- id UUID PK, created_at TIMESTAMPTZ, final_approved_mockup_url TEXT, gst_percentage NUMERIC, height_cm NUMERIC, hsn_code TEXT, is_personalized BOOLEAN, length_cm NUMERIC, liability_shifted_at TIMESTAMPTZ, order_id UUID NOT NULL FK(orders), personalization_details JSONB, personalization_revision_count INT, personalization_schema JSONB, product_id UUID NOT NULL FK(products), product_image_url TEXT, product_name TEXT, quantity INT NOT NULL, selected_addons JSONB, selected_variant_id UUID FK(product_variants), selected_variant_options JSONB, status order_status, stock_deducted BOOLEAN, total_price NUMERIC NOT NULL, unit_price NUMERIC NOT NULL, vendor_production_notes TEXT, weight_kg NUMERIC, width_cm NUMERIC

-- order_status_history
-- id UUID PK, changed_at TIMESTAMPTZ, metadata JSONB, order_id UUID NOT NULL FK(orders), status order_status

-- order_valid_transitions
-- id UUID PK, created_at TIMESTAMPTZ, from_status order_status, required_personalization_approval BOOLEAN, to_status order_status NOT NULL

-- orders
-- id UUID PK, address_id UUID FK(user_addresses), awb_number TEXT, billing_address JSONB, cancellation_reason TEXT, cancelled_by TEXT, cashback_amount NUMERIC, cashback_credited BOOLEAN, change_request_count INT, courier_tracking_id TEXT, courier_vendor TEXT, created_at TIMESTAMPTZ, delivery_address JSONB, delivery_fee NUMERIC, delivery_instructions TEXT, discount NUMERIC, distance_km NUMERIC, estimate_downloaded BOOLEAN, gstin TEXT, gstin_verified BOOLEAN, has_personalization BOOLEAN, idempotency_key TEXT, max_change_requests INT, order_number TEXT NOT NULL, payment_id TEXT, payment_method TEXT, payment_status TEXT, payout_id UUID FK(vendor_payouts), personalization_charges NUMERIC, platform_fee NUMERIC, price_locked_until TIMESTAMPTZ, promised_delivery_at TIMESTAMPTZ, razorpay_order_id TEXT, refunded_amount NUMERIC, return_deadline TIMESTAMPTZ, shadowfax_tracking_url TEXT, status order_status, subtotal NUMERIC NOT NULL, tax_amount NUMERIC, total NUMERIC NOT NULL, updated_at TIMESTAMPTZ, user_id UUID NOT NULL FK(users), vendor_id UUID NOT NULL FK(vendors)

-- platform_settings
-- key TEXT PK, updated_at TIMESTAMPTZ, value JSONB NOT NULL

-- product_addon_groups (junction)
-- addon_group_id UUID FK(addon_groups), display_order INT, product_id UUID FK(products), PRIMARY KEY(addon_group_id, product_id)

-- product_addons
-- id UUID PK, created_at TIMESTAMPTZ, group_id UUID FK(addon_groups), is_available BOOLEAN, name TEXT NOT NULL, price NUMERIC

-- product_submissions
