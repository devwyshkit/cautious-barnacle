-- id UUID PK, approved_mockup_url TEXT, created_at TIMESTAMPTZ, delivered_photo_url TEXT, delivery_rating NUMERIC, fidelity_rating NUMERIC, fidelity_tags TEXT[], images TEXT[], is_anonymous BOOLEAN, is_personalised_review BOOLEAN, order_id UUID NOT NULL FK(orders), order_product_id UUID FK(order_products), personalization_rating NUMERIC, product_id UUID FK(products), rating NUMERIC NOT NULL, review_text TEXT, revision_count INT, tags TEXT[], user_id UUID NOT NULL FK(users), vendor_id UUID NOT NULL FK(vendors), vendor_replied_at TIMESTAMPTZ, vendor_reply TEXT, vendor_response_time_rating NUMERIC

-- user_addresses
-- id UUID PK, address_line1 TEXT NOT NULL, address_line2 TEXT, city TEXT, country TEXT, created_at TIMESTAMPTZ, gstin TEXT, is_default BOOLEAN, latitude NUMERIC, location GEOMETRY, longitude NUMERIC, name TEXT NOT NULL, phone TEXT NOT NULL, pincode TEXT, state TEXT, type TEXT NOT NULL, updated_at TIMESTAMPTZ, user_id UUID NOT NULL FK(users)

