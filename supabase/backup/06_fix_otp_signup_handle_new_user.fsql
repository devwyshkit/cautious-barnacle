-- =============================================================================
-- WYSHKIT 2026: Fix "Database error saving new user" on OTP signup
-- Run in Supabase Dashboard > SQL Editor
-- 
-- The +91 phone prefix is CORRECT (E.164 format). The error is caused by a
-- failing trigger that syncs auth.users → public.users.
-- =============================================================================

BEGIN;

-- 1. Drop existing trigger (may have broken logic)
DROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;

-- 2. Create robust handle_new_user - works for both email and PHONE signups
CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS TRIGGER
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  -- Insert into public.users (sync from auth.users)
  -- For phone OTP: NEW.phone has value, NEW.email is often null
  INSERT INTO public.users (
    id,
    email,
    phone,
    full_name,
    avatar_url,
    status,
    created_at,
    updated_at
  )
  VALUES (
    NEW.id,
    COALESCE(NEW.email, (NEW.raw_user_meta_data->>'email')),
    COALESCE(NEW.phone, (NEW.raw_user_meta_data->>'phone')),
    COALESCE(
      NEW.raw_user_meta_data->>'full_name',
      NEW.raw_user_meta_data->>'name',
      COALESCE(NEW.phone, NEW.email, NEW.id::text)
    ),
    NEW.raw_user_meta_data->>'avatar_url',
    'active',
    NOW(),
    NOW()
  )
  ON CONFLICT (id) DO UPDATE SET
    phone = COALESCE(EXCLUDED.phone, public.users.phone),
    email = COALESCE(EXCLUDED.email, public.users.email),
    full_name = COALESCE(EXCLUDED.full_name, public.users.full_name),
    updated_at = NOW();
  
  RETURN NEW;
END;
$$;

-- 3. Recreate trigger
CREATE TRIGGER on_auth_user_created
  AFTER INSERT ON auth.users
  FOR EACH ROW
  EXECUTE FUNCTION public.handle_new_user();

COMMIT;
